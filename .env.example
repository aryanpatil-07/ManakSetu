# StandardSense (ManakSetu) Environment Configuration
# Copy this file to .env in backend/ or repository root

# Application Metadata
PROJECT_NAME="ManakSetu Engine"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api"

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","*"]

# Engine Retrieval & Quality Control Settings
BM25_TOP_K=5
SIMILARITY_THRESHOLD=0.65
RATE_LIMIT_PER_MINUTE=60

# Frontend Environment Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
